<?xml version='1.0' encoding='UTF-8'?>
<mxfile host="drawio" type="device">
  <diagram id="records-flow" name="Records inspection">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1216" pageHeight="600" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="id" value="&lt;div style=&quot;font-size:22px;line-height:26.40px&quot;&gt;Run ID&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:12px;font-weight:normal;color:#5F6B7A&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;From the saved run folder&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=nowrap;strokeColor=#232F3E;fillColor=none;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacing=0;spacingLeft=16;spacingTop=16;fontSize=14;fontStyle=1;fontColor=#232F3E;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="40" width="312" height="180" />
        </mxCell>
        <mxCell id="log" value="&lt;div style=&quot;font-size:22px;line-height:26.40px&quot;&gt;box runs history &amp;lt;box-id&amp;gt;&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:12px;font-weight:normal;color:#5F6B7A&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;Read the saved run log:&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;records.jsonl&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=nowrap;strokeColor=#232F3E;fillColor=none;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacing=0;spacingLeft=16;spacingTop=16;fontSize=14;fontStyle=1;fontColor=#232F3E;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="442" y="40" width="312" height="180" />
        </mxCell>
        <mxCell id="decisions" value="&lt;div style=&quot;font-size:22px;line-height:26.40px&quot;&gt;Policy decisions&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:12px;font-weight:normal;color:#5F6B7A&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;Select recorded decisions.&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;Skip other log events.&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=nowrap;strokeColor=#232F3E;fillColor=none;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacing=0;spacingLeft=16;spacingTop=16;fontSize=14;fontStyle=1;fontColor=#232F3E;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="844" y="40" width="312" height="180" />
        </mxCell>
        <mxCell id="filters" value="&lt;div style=&quot;font-size:22px;line-height:26.40px&quot;&gt;Match all filters&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:12px;font-weight:normal;color:#5F6B7A&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;--deny: deny unless&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;enforced is boolean false.&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;--would-deny: deny when&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;enforced is boolean false.&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;Use at most one result flag.&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;--action, --resource, --since&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=nowrap;strokeColor=#232F3E;fillColor=none;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacing=0;spacingLeft=16;spacingTop=16;fontSize=14;fontStyle=1;fontColor=#232F3E;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="340" width="312" height="220" />
        </mxCell>
        <mxCell id="tail" value="&lt;div style=&quot;font-size:22px;line-height:26.40px&quot;&gt;--tail N&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:12px;font-weight:normal;color:#5F6B7A&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;Last N matching decisions&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;Recorded order retained&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;Repeated decisions kept&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;Optional; no limit by default&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=nowrap;strokeColor=#232F3E;fillColor=none;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacing=0;spacingLeft=16;spacingTop=16;fontSize=14;fontStyle=1;fontColor=#232F3E;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="442" y="340" width="312" height="220" />
        </mxCell>
        <mxCell id="output" value="&lt;div style=&quot;font-size:22px;line-height:26.40px&quot;&gt;Text or JSON&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:12px;font-weight:normal;color:#5F6B7A&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;--format text (default)&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;6 columns; RESULT can show&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;&amp;quot;would deny&amp;quot;&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;--format json: 7 keys&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;Raw result, plus enforced:&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;true, false, or null&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=nowrap;strokeColor=#232F3E;fillColor=none;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacing=0;spacingLeft=16;spacingTop=16;fontSize=14;fontStyle=1;fontColor=#232F3E;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="844" y="340" width="312" height="220" />
        </mxCell>
        <mxCell id="flow-0" value="Use ID" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#545B64;strokeWidth=2.5;dashed=0;endArrow=block;endFill=1;endSize=10;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=18;fontStyle=2;fontColor=#414D5C;fontFamily=Arial,Helvetica,sans-serif;labelBackgroundColor=none;" edge="1" parent="1" source="id" target="log">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="offset" x="0" y="-15" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow-1" value="Select" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#545B64;strokeWidth=2.5;dashed=0;endArrow=block;endFill=1;endSize=10;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=18;fontStyle=2;fontColor=#414D5C;fontFamily=Arial,Helvetica,sans-serif;labelBackgroundColor=none;" edge="1" parent="1" source="log" target="decisions">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="offset" x="0" y="-15" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow-2" value="Apply filters" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#545B64;strokeWidth=2.5;dashed=0;endArrow=block;endFill=1;endSize=10;startArrow=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=18;fontStyle=2;fontColor=#414D5C;fontFamily=Arial,Helvetica,sans-serif;labelBackgroundColor=none;" edge="1" parent="1" source="decisions" target="filters">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1000" y="280" />
              <mxPoint x="196" y="280" />
            </Array>
            <mxPoint as="offset" x="0" y="-15" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow-3" value="Then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#545B64;strokeWidth=2.5;dashed=0;endArrow=block;endFill=1;endSize=10;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=18;fontStyle=2;fontColor=#414D5C;fontFamily=Arial,Helvetica,sans-serif;labelBackgroundColor=none;" edge="1" parent="1" source="filters" target="tail">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="offset" x="0" y="-15" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow-4" value="Print" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#545B64;strokeWidth=2.5;dashed=0;endArrow=block;endFill=1;endSize=10;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=18;fontStyle=2;fontColor=#414D5C;fontFamily=Arial,Helvetica,sans-serif;labelBackgroundColor=none;" edge="1" parent="1" source="tail" target="output">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="offset" x="0" y="-15" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>