<?xml version='1.0' encoding='utf-8'?>
<mxfile host="drawio" type="device">
  <diagram id="linux-x86-package-build" name="Linux package build baseline">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1080" pageHeight="900" math="0" shadow="0" background="#ffffff">
      <root>
