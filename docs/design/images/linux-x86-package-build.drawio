        <mxCell id="arm-builder" value="&lt;div style=&quot;font-size:22px;line-height:26.4px;font-weight:bold&quot;&gt;Amazon Linux 2023&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;Build container&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;GNU C library (glibc) 2.34&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=nowrap;fillColor=none;strokeWidth=2;verticalAlign=top;align=left;spacing=0;spacingLeft=16;fontSize=14;fontStyle=1;strokeColor=#232F3E;fontColor=#232F3E;fontFamily=Arial,Helvetica,sans-serif;spacingTop=14;" vertex="1" parent="1">
