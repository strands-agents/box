        <mxCell id="linux-download" value="&lt;div style=&quot;font-size:22px;line-height:26.4px;font-weight:bold&quot;&gt;Download for this Linux CPU&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;ARM64: linux-arm64&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;x86-64: linux-x86_64&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;Verify the selected checksum&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=nowrap;fillColor=none;strokeWidth=2;verticalAlign=top;align=left;spacing=0;spacingLeft=16;fontSize=14;fontStyle=1;strokeColor=#232F3E;fontColor=#232F3E;fontFamily=Arial,Helvetica,sans-serif;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="600" y="780" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="linux-release" value="&lt;div style=&quot;font-size:22px;line-height:26.4px;font-weight:bold&quot;&gt;Release Box publication&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;publish_linux=true selects ARM64&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;publish_linux_x86=true adds x86-64&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;Selected archives + SHA256SUMS.txt&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;Required qualification and approval&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=nowrap;fillColor=none;strokeWidth=2;verticalAlign=top;align=left;spacing=0;spacingLeft=16;fontSize=14;fontStyle=1;strokeColor=#232F3E;fontColor=#232F3E;fontFamily=Arial,Helvetica,sans-serif;spacingTop=14;" vertex="1" parent="1">
