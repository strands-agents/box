        <mxCell id="launch-after" value="&lt;div style=&quot;font-size:22px;line-height:26.4px;font-weight:bold&quot;&gt;Linux x86-64 launch&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=nowrap;fillColor=none;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacing=0;spacingLeft=16;fontSize=14;fontStyle=1;fontFamily=Arial,Helvetica,sans-serif;strokeColor=#232F3E;fontColor=#232F3E;spacingTop=24;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sandbox" value="&lt;div style=&quot;font-size:22px;line-height:26.4px;font-weight:bold&quot;&gt;Existing Linux sandbox&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;Existing restrictions remain&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=nowrap;fillColor=none;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacing=0;spacingLeft=16;fontSize=14;fontStyle=1;fontFamily=Arial,Helvetica,sans-serif;strokeColor=#232F3E;fontColor=#232F3E;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="660" y="300" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="permissions" value="&lt;div style=&quot;font-size:22px;line-height:26.4px;font-weight:bold&quot;&gt;Added x86-only permissions&lt;/div&gt;&lt;div style=&quot;height:10px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal&quot;&gt;open, access, stat, lstat, readlink, rename, unlink, symlink&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal&quot;&gt;epoll_wait, dup2, poll, pipe, getpgrp, vfork&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal&quot;&gt;mkdir, chmod: reject special permission bits&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal&quot;&gt;open: apply existing file-creation mode checks&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal&quot;&gt;arch_prctl: ARCH_SET_FS only&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:24px;font-weight:normal;color:#5F6B7A&quot;&gt;Points the thread to its local data&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=nowrap;fillColor=none;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacing=0;spacingLeft=16;fontSize=14;fontStyle=1;fontFamily=Arial,Helvetica,sans-serif;strokeColor=#232F3E;fontColor=#232F3E;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="500" height="240" as="geometry" />
        </mxCell>
        <mxCell id="before-rejected" value="Architecture rejected" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=18;fontStyle=2;fontColor=#414D5C;labelBackgroundColor=none;fontFamily=Arial,Helvetica,sans-serif;strokeColor=#DD344C;dashed=1;dashPattern=8 6;fixDash=1;" edge="1" parent="1" source="launch-before" target="stopped">
          <mxGeometry relative="1" as="geometry">
