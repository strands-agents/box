          <mxGeometry x="40" y="240" width="960" height="40" as="geometry" />
        </mxCell>
        <mxCell id="launch-before" value="&lt;div style=&quot;font-size:22px;line-height:26.4px;font-weight:bold&quot;&gt;Linux x86-64 launch&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=nowrap;fillColor=none;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacing=0;spacingLeft=16;fontSize=14;fontStyle=1;fontFamily=Arial,Helvetica,sans-serif;strokeColor=#232F3E;fontColor=#232F3E;spacingTop=24;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="stopped" value="&lt;div style=&quot;font-size:22px;line-height:26.4px;font-weight:bold&quot;&gt;Workload does not start&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=nowrap;fillColor=none;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacing=0;spacingLeft=16;fontSize=14;fontStyle=1;fontFamily=Arial,Helvetica,sans-serif;strokeColor=#DD344C;fontColor=#DD344C;spacingTop=24;" vertex="1" parent="1">
