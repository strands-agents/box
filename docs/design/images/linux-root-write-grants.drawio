              <mxPoint x="120" y="560" />
            </Array>
            <mxPoint as="offset" x="0" y="-15" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e-consumer-outside" value="if its permissions allow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#545B64;strokeWidth=2.5;dashed=0;endArrow=block;endFill=1;endSize=10;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=18;fontStyle=2;fontColor=#414D5C;fontFamily=Arial,Helvetica,sans-serif;labelBackgroundColor=none;" edge="1" parent="1" source="consumer" target="outside">
          <mxGeometry as="geometry" x="0.4" relative="1">
            <Array as="points">
              <mxPoint x="1280" y="240" />
              <mxPoint x="1280" y="560" />
