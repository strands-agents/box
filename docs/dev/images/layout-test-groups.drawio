        <mxCell id="before-title" value="Before" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#232F3E;strokeWidth=2;fontColor=#232F3E;fontSize=24;fontFamily=Arial,Helvetica,sans-serif;strokeColor=none;fontStyle=1;fontSize=22;">
