          <mxGeometry as="geometry" x="40" y="150" width="280" height="240" />
        </mxCell>
        <mxCell id="after" value="After: layout::tests" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#232F3E;strokeWidth=2;fontColor=#232F3E;fontSize=24;fontFamily=Arial,Helvetica,sans-serif;fillColor=none;verticalAlign=top;align=left;spacingLeft=16;spacingTop=16;fontSize=22;fontStyle=1;">
          <mxGeometry as="geometry" x="560" y="40" width="400" height="460" />
        </mxCell>
        <mxCell id="identity" value="record_identity.rs" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#232F3E;strokeWidth=2;fontColor=#232F3E;fontSize=24;fontFamily=Arial,Helvetica,sans-serif;">
          <mxGeometry as="geometry" x="600" y="120" width="320" height="90" />
        </mxCell>
        <mxCell id="recovery" value="recovery.rs" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#232F3E;strokeWidth=2;fontColor=#232F3E;fontSize=24;fontFamily=Arial,Helvetica,sans-serif;">
          <mxGeometry as="geometry" x="600" y="250" width="320" height="90" />
        </mxCell>
        <mxCell id="remaining" value="Other tests and shared&lt;br&gt;helpers stay in layout.rs" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#232F3E;strokeWidth=2;fontColor=#232F3E;fontSize=24;fontFamily=Arial,Helvetica,sans-serif;strokeColor=none;fontSize=18;fontColor=#5F6B7A;">
          <mxGeometry as="geometry" x="600" y="380" width="320" height="80" />
