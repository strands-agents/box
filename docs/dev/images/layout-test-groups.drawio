        <mxCell id="extract" value="Group by behavior" edge="1" source="before" target="after" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#545B64;strokeWidth=2.5;endSize=10;endArrow=block;endFill=1;fontSize=18;fontStyle=2;fontColor=#414D5C;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial,Helvetica,sans-serif;">
          <mxGeometry as="geometry" relative="1">
