<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="layout-test-groups" name="Layout tests">
    <mxGraphModel background="#ffffff" page="0" grid="1" gridSize="10">
      <root>
