<?xml version='1.0' encoding='utf-8'?>
<mxfile>
  <diagram name="Cluster compatibility">
    <mxGraphModel background="#ffffff" page="0" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="client" value="Deployment client" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#232F3E;strokeWidth=2;fontSize=24;fontColor=#232F3E;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="api" value="Kubernetes API&lt;br&gt;on Amazon EKS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ED7100;strokeWidth=2;fontSize=24;fontColor=#ED7100;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="480" y="80" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="check" value="Compare required&lt;br&gt;sandbox settings" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#232F3E;strokeWidth=2;fontSize=24;fontColor=#232F3E;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="480" y="310" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="submit" value="Create Job;&lt;br&gt;check actual Pods" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#232F3E;strokeWidth=2;fontSize=24;fontColor=#232F3E;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="910" y="310" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="stop" value="Configuration error;&lt;br&gt;no Job created" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#DD344C;strokeWidth=2;fontSize=24;fontColor=#DD344C;fontFamily=Arial,Helvetica,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="480" y="540" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="request" value="1. Server dry run" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;fontSize=18;fontStyle=2;fontColor=#414D5C;labelBackgroundColor=#ffffff;strokeColor=#545B64;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial,Helvetica,sans-serif;" edge="1" parent="1" source="client" target="api">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
            <mxPoint x="0" y="-20" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="returned" value="2. Returned settings" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;fontSize=18;fontStyle=2;fontColor=#414D5C;labelBackgroundColor=#ffffff;strokeColor=#545B64;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial,Helvetica,sans-serif;" edge="1" parent="1" source="api" target="check">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
            <mxPoint x="115" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="compatible" value="3. Preserved" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;fontSize=18;fontStyle=2;fontColor=#414D5C;labelBackgroundColor=#ffffff;strokeColor=#545B64;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial,Helvetica,sans-serif;" edge="1" parent="1" source="check" target="submit">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
            <mxPoint x="0" y="-20" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="refused" value="3. Missing or changed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;fontSize=18;fontStyle=2;fontColor=#414D5C;labelBackgroundColor=#ffffff;strokeColor=#DD344C;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Arial,Helvetica,sans-serif;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="check" target="stop">
          <mxGeometry relative="1" as="geometry">
