// @box/open, with the two rules on the answer of [enrichment.threat], which the enrichment test
// pack declares.

// Let the box's shell run each command the agent gives it. Each file a command touches is still
// its own decision. To allow only some commands, add a condition that names them before the `;`:
//
// when { ["cd", "pwd", "ls", "cat", "grep", "head", "tail", "wc"].contains(context.input.program) };
@id("shell_commands")
permit (principal, action == Box::Action::"shell:exec", resource);

// Let programs read and write /dev/null, which they redirect output to all the time.
@id("dev_null")
permit (principal, action in [Box::Action::"fs:read", Box::Action::"fs:write"], resource)
when { context.input.path == "/dev/null" };

// Let the agent connect to any host.
@id("open_connect")
permit (principal, action == Box::Action::"net:connect", resource);

// Let the agent send HTTP requests to any host.
@id("open_request")
permit (principal, action == Box::Action::"http:request", resource);

// Let the agent open a WebSocket to any host.
@id("open_websocket")
permit (principal, action == Box::Action::"websocket:connect", resource);

// But never to a loopback address. A service on this machine that listens on all interfaces is
// still reachable at this machine's network address.
@id("open_loopback")
forbid (principal, action == Box::Action::"net:connect", resource)
when {
  (context.input has ip4 && (context.input.ip4 like "127.*" || context.input.ip4 == "0.0.0.0")) ||
  (context.input has ip6 && (context.input.ip6 == "::1" || context.input.ip6 == "::"))
};

// Or to a link-local address. Most clouds serve the machine's credentials from 169.254.169.254,
// and this covers it on any cloud, whatever name resolves to it.
@id("open_link_local")
forbid (principal, action == Box::Action::"net:connect", resource)
when {
  (context.input has ip4 && context.input.ip4 like "169.254.*") ||
  (context.input has ip6 && (
    context.input.ip6 like "fe8*" || context.input.ip6 like "fe9*" ||
    context.input.ip6 like "fea*" || context.input.ip6 like "feb*"
  ))
};

// Refuse a host that the classification source labels malware.
@id("block_malware")
forbid (principal, action == Box::Action::"net:connect", resource)
when { context.input.enrichment.threat.labels.contains("malware") };

// Refuse a host that the source gave no answer about, and so every connection to an IP address.
@id("require_answer")
forbid (principal, action == Box::Action::"net:connect", resource)
unless { context.input.enrichment.threat.answered };
