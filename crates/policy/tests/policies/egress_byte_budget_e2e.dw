// The same completion-based outbound byte budget as `egress_byte_budget.dw`,
// calibrated for real HTTP traffic.
//
// The threshold is 400 bytes rather than 100 because the gateway reports the whole
// serialized request written to the socket, including headers. A 10-byte body
// therefore charges about 150 bytes.
//
// Sum delivered request bytes from `http:request::response` outcomes recorded in
// the last 60 seconds. The gateway records the outcome when the exchange ends,
// including completion, failure, or timeout. Pending exchanges do not count yet,
// so stalled or concurrent exchanges can exceed the threshold. The rule also
// excludes the next request's size from the comparison, so it can overshoot.
//
// A denied attempt adds no delivered bytes and does not consume this budget.
// `::request` events describe offered bytes, so this rule does not sum them.
@id("egress_byte_budget_e2e")
permit (
    principal,
    action == Box::Action::"http:request",
    resource
)
when temporal {
    exists (total: Long). (
        (sum b for (b: Long), (t: Timepoint). where (
            formerly within 60s (
                Box::Action::"http:request"::response{ input.host: _, input.body_bytes: b } && tp(t)
            )
        )) == total
        && total < 400
    )
};
