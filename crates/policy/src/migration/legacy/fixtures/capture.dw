permit(principal == Box::Agent::"self", action == Box::Action::"http:request", resource)
when temporal {
    exists (t_93: Timepoint). (
        tp(t_93) &&
        exists (total: Long). (
            (sum_within(b, 86400s, (Box::Action::"http:request"::response{ input.host: _, input.body_bytes: b } && tp(t_93)))) == total
            && total < 100
        )
    )
};
